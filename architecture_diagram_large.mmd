  "theme": "base",
  "themeVariables": {
    "primaryColor": "#E8F4FD",
    "primaryTextColor": "#1A2B4A",
    "primaryBorderColor": "#2D7DD2",
    "lineColor": "#4A6FA5",
    "secondaryColor": "#E6F7F5",
    "tertiaryColor": "#FFF8E7",
    "background": "#FFFFFF",
    "mainBkg": "#E8F4FD",
    "nodeBorder": "#2D7DD2",
    "clusterBkg": "#F0F7FF",
